# Copy and export. Nothing here is required as a baked-in path.
# Example values only — replace with your local dirs / GPU UUID / port.

# --- launch ---
# MODEL_DIR=$HOME/models/Qwen3.8-27B-NVFP4-unsloth-modelopt
# DRAFT_DIR=$HOME/models/Qwen3.8-27B-DFlash2
# GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PORT=8040
# HOST=127.0.0.1
# OVERLAY_DIR=            # default: <this-tree>/overlay
# FLASHINFER_CACHE=       # optional FlashInfer JIT cache dir
# Pin the image. Templates use --pull=never; pull this digest first.
# IMAGE=lmsysorg/sglang@sha256:96cbac6a4c834f8233873b19df6f0e025658d53fb81b8baa510bc9cd3ea62b95
# CONTAINER_NAME=qwen38-sglang-dflash2
# MEM_FRACTION=0.85
# CONTEXT_LENGTH=32768

# --- convert (CPU, no GPU). Three successive output dirs; do not overwrite SRC. ---
# SRC_DIR=$HOME/models/Qwen3.8-27B-NVFP4-unsloth
# LMHEADFIX_DIR=$HOME/models/Qwen3.8-27B-NVFP4-unsloth-lmheadfix
# W4A4_DIR=$HOME/models/Qwen3.8-27B-NVFP4-unsloth-w4a4attn
# MODELOPT_DIR=$HOME/models/Qwen3.8-27B-NVFP4-unsloth-modelopt
# HUIHUI_DIR is required for pack_unsloth_w4a4attn.py --huihui (read-only input_scale steal).
# It is a Huihui NVFP4 checkpoint, not SRC_DIR.
# HUIHUI_DIR=$HOME/models/Huihui-Qwen3.8-27B-abliterated-thinking-cut-k2-nvfp4-w4a4

# huihui-dflash2 recipe uses a Huihui checkpoint as MODEL_DIR instead of MODELOPT_DIR:
# MODEL_DIR=$HOME/models/Huihui-Qwen3.8-27B-abliterated-thinking-cut-k2-nvfp4-w4a4

# --- short-prompt bench ---
# BENCH_BASE=http://127.0.0.1:8040
# BENCH_MODEL=/model
# BENCH_RECIPE=unsloth-dflash2

# --- long-context REAL-text bench ---
# TOKENIZER_DIR=$MODELOPT_DIR
# BENCH_OUT_JSON=results/long-context-run.json
# BENCH_OUT_MD=results/long-context-run.md
