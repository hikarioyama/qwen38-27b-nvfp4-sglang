#!/usr/bin/env bash
# Huihui NVFP4 + DFlash2 K=8 + ReplaySSM, overlap off.
# No --max-running-requests (server default). No --gpus. docker run -d.
#
# Required env: MODEL_DIR, DRAFT_DIR, GPU_UUID
# Optional: PORT (8040), HOST (127.0.0.1), OVERLAY_DIR, FLASHINFER_CACHE,
#           IMAGE, CONTAINER_NAME, MEM_FRACTION (0.85), CONTEXT_LENGTH (32768)
#
# Example (not required):
#   MODEL_DIR=$HOME/models/Huihui-Qwen3.8-27B-abliterated-thinking-cut-k2-nvfp4-w4a4
#   DRAFT_DIR=$HOME/models/Qwen3.8-27B-DFlash2
#   GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   PORT=8040
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODEL_DIR="${MODEL_DIR:?set MODEL_DIR to the Huihui NVFP4 checkpoint}"
DRAFT_DIR="${DRAFT_DIR:?set DRAFT_DIR to the DFlash2 draft checkpoint}"
GPU_UUID="${GPU_UUID:?set GPU_UUID (NVIDIA_VISIBLE_DEVICES)}"
PORT="${PORT:-8040}"
HOST="${HOST:-127.0.0.1}"
OVERLAY_DIR="${OVERLAY_DIR:-$ROOT/overlay}"
FLASHINFER_CACHE="${FLASHINFER_CACHE:-}"
IMAGE="${IMAGE:-lmsysorg/sglang:dev-cu13}"
CONTAINER_NAME="${CONTAINER_NAME:-qwen38-sglang-dflash2}"
MEM_FRACTION="${MEM_FRACTION:-0.85}"
CONTEXT_LENGTH="${CONTEXT_LENGTH:-32768}"
SGL_PY="/sgl-workspace/sglang/python/sglang"

CACHE_ARGS=()
if [[ -n "$FLASHINFER_CACHE" ]]; then
  CACHE_ARGS=(-v "$FLASHINFER_CACHE:/root/.cache/flashinfer")
fi

exec docker run -d --rm --name "$CONTAINER_NAME" \
  --runtime=nvidia --ipc=host --shm-size 32g --network=host \
  --memory=100g --memory-swap=100g --pull=never \
  -e NVIDIA_VISIBLE_DEVICES="$GPU_UUID" \
  -e CUDA_VISIBLE_DEVICES=0 \
  -e CUDA_DEVICE_ORDER=PCI_BUS_ID \
  -e HF_HUB_OFFLINE=1 \
  -e TORCHINDUCTOR_COMPILE_THREADS=6 \
  -e MAX_JOBS=6 \
  -e NVCC_THREADS=2 \
  -v "$MODEL_DIR":/model:ro \
  -v "$DRAFT_DIR":/model-draft:ro \
  "${CACHE_ARGS[@]}" \
  -v "$OVERLAY_DIR/srt/model_executor/model_runner_components/spec_aux_hidden_state.py:$SGL_PY/srt/model_executor/model_runner_components/spec_aux_hidden_state.py:ro" \
  -v "$OVERLAY_DIR/srt/models/dflash.py:$SGL_PY/srt/models/dflash.py:ro" \
  -v "$OVERLAY_DIR/srt/speculative/dflash_utils.py:$SGL_PY/srt/speculative/dflash_utils.py:ro" \
  -v "$OVERLAY_DIR/srt/speculative/dflash_worker_v2.py:$SGL_PY/srt/speculative/dflash_worker_v2.py:ro" \
  -v "$OVERLAY_DIR/kernels/ops/speculative/dflash.py:$SGL_PY/kernels/ops/speculative/dflash.py:ro" \
  -v "$OVERLAY_DIR/srt/speculative/spec_utils.py:$SGL_PY/srt/speculative/spec_utils.py:ro" \
  -v "$OVERLAY_DIR/srt/mem_cache/kv_cache_configurator.py:$SGL_PY/srt/mem_cache/kv_cache_configurator.py:ro" \
  "$IMAGE" \
  python -m sglang.launch_server \
    --model-path /model \
    --trust-remote-code \
    --quantization modelopt_fp4 \
    --kv-cache-dtype fp8_e4m3 \
    --attention-backend flashinfer \
    --mem-fraction-static "$MEM_FRACTION" \
    --disable-custom-all-reduce \
    --host "$HOST" --port "$PORT" \
    --chat-template /model/chat_template.jinja \
    --default-chat-template-kwargs '{"enable_thinking":false}' \
    --language-only \
    --context-length "$CONTEXT_LENGTH" \
    --speculative-algorithm DFLASH \
    --speculative-draft-model-path /model-draft \
    --speculative-draft-model-quantization unquant \
    --speculative-num-draft-tokens 8 \
    --disable-overlap-schedule \
    --enable-linear-replayssm-spec
