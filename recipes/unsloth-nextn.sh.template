#!/usr/bin/env bash
# Unsloth lmheadfix NVFP4 + NEXTN (no DFlash2 overlay).
# --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4
# No --gpus. docker run -d.
#
# Required env: MODEL_DIR, GPU_UUID
# Optional: PORT (8040), HOST (127.0.0.1), FLASHINFER_CACHE, IMAGE,
#           CONTAINER_NAME, MEM_FRACTION (0.85), CONTEXT_LENGTH (32768),
#           MAX_RUNNING_REQUESTS (64)
#
# Example (not required):
#   MODEL_DIR=$HOME/models/Qwen3.8-27B-NVFP4-unsloth-lmheadfix
#   GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   PORT=8040
set -euo pipefail

MODEL_DIR="${MODEL_DIR:?set MODEL_DIR to the Unsloth lmheadfix NVFP4 checkpoint}"
GPU_UUID="${GPU_UUID:?set GPU_UUID (NVIDIA_VISIBLE_DEVICES)}"
PORT="${PORT:-8040}"
HOST="${HOST:-127.0.0.1}"
FLASHINFER_CACHE="${FLASHINFER_CACHE:-}"
IMAGE="${IMAGE:-lmsysorg/sglang:dev-cu13}"
CONTAINER_NAME="${CONTAINER_NAME:-qwen38-sglang-unsloth-nextn}"
MEM_FRACTION="${MEM_FRACTION:-0.85}"
CONTEXT_LENGTH="${CONTEXT_LENGTH:-32768}"
MAX_RUNNING_REQUESTS="${MAX_RUNNING_REQUESTS:-64}"

CACHE_ARGS=()
if [[ -n "$FLASHINFER_CACHE" ]]; then
  CACHE_ARGS=(-v "$FLASHINFER_CACHE:/root/.cache/flashinfer")
fi

MRR_ARGS=()
if [[ -n "$MAX_RUNNING_REQUESTS" ]]; then
  MRR_ARGS=(--max-running-requests "$MAX_RUNNING_REQUESTS")
fi

exec docker run -d --rm --name "$CONTAINER_NAME" \
  --runtime=nvidia --ipc=host --shm-size 32g --network=host \
  --memory=100g --memory-swap=100g --pull=never \
  -e NVIDIA_VISIBLE_DEVICES="$GPU_UUID" \
  -e CUDA_VISIBLE_DEVICES=0 \
  -e CUDA_DEVICE_ORDER=PCI_BUS_ID \
  -e HF_HUB_OFFLINE=1 \
  -e TORCHINDUCTOR_COMPILE_THREADS=6 \
  -e MAX_JOBS=6 \
  -e NVCC_THREADS=2 \
  -v "$MODEL_DIR":/model:ro \
  "${CACHE_ARGS[@]}" \
  "$IMAGE" \
  python -m sglang.launch_server \
    --model-path /model \
    --trust-remote-code \
    --speculative-algorithm NEXTN \
    --speculative-num-steps 3 \
    --speculative-eagle-topk 1 \
    --speculative-num-draft-tokens 4 \
    --kv-cache-dtype fp8_e4m3 \
    --attention-backend flashinfer \
    --mem-fraction-static "$MEM_FRACTION" \
    --disable-custom-all-reduce \
    --host "$HOST" --port "$PORT" \
    --chat-template /model/chat_template.jinja \
    --default-chat-template-kwargs '{"enable_thinking":false}' \
    --language-only \
    --context-length "$CONTEXT_LENGTH" \
    "${MRR_ARGS[@]}"
